{
	"Name": "Feishin",
	"Version": "2.0.0.0",
	"Author": "jwowk",
	"Actions": [
		{
			"Name": "Play / Pause",
			"UUID": "net.jwowk.feishin.playpause",
			"Icon": "imgs/actions/playpause/icon",
			"Tooltip": "Toggle play/pause on the connected Feishin host.",
			"PropertyInspectorPath": "ui/inspector.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/playpause/key",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Next",
			"UUID": "net.jwowk.feishin.next",
			"Icon": "imgs/actions/next/icon",
			"Tooltip": "Skip to the next track.",
			"PropertyInspectorPath": "ui/inspector.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/next/key"
				}
			]
		},
		{
			"Name": "Previous",
			"UUID": "net.jwowk.feishin.previous",
			"Icon": "imgs/actions/previous/icon",
			"Tooltip": "Go back to the previous track.",
			"PropertyInspectorPath": "ui/inspector.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/previous/key"
				}
			]
		},
		{
			"Name": "Volume Up",
			"UUID": "net.jwowk.feishin.volumeup",
			"Icon": "imgs/actions/volumeup/icon",
			"Tooltip": "Raise the Feishin volume.",
			"PropertyInspectorPath": "ui/inspector.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/volumeup/key"
				}
			]
		},
		{
			"Name": "Volume Down",
			"UUID": "net.jwowk.feishin.volumedown",
			"Icon": "imgs/actions/volumedown/icon",
			"Tooltip": "Lower the Feishin volume.",
			"PropertyInspectorPath": "ui/inspector.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/volumedown/key"
				}
			]
		},
		{
			"Name": "Volume Dial",
			"UUID": "net.jwowk.feishin.volumedial",
			"Icon": "imgs/actions/volumedial/icon",
			"Tooltip": "Turn to change volume, press to play/pause.",
			"PropertyInspectorPath": "ui/inspector.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Rotate": "Adjust volume",
					"Push": "Play / Pause",
					"Touch": "Play / Pause"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/volumedial/key"
				}
			]
		},
		{
			"Name": "Transport Dial",
			"UUID": "net.jwowk.feishin.transport",
			"Icon": "imgs/actions/transport/icon",
			"Tooltip": "Turn to skip tracks, press to play/pause.",
			"PropertyInspectorPath": "ui/inspector.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "$A1",
				"TriggerDescription": {
					"Rotate": "Previous / Next track",
					"Push": "Play / Pause",
					"Touch": "Play / Pause"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/transport/key"
				}
			]
		}
	],
	"Category": "Feishin",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Control Feishin playback (server-side or desktop) from your Stream Deck — play/pause, skip, and volume, with dials.",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		},
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"UUID": "net.jwowk.feishin"
}